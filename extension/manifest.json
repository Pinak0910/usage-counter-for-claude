{
  "manifest_version": 3,
  "name": "Usage Counter for Claude",
  "short_name": "Usage Counter",
  "version": "1.0.0",
  "description": "Your Claude session and weekly usage in a slim line above the claude.ai chat box. Nothing leaves your browser.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "usage-api.js",
        "shape.js",
        "statusline.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Usage Counter for Claude",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}